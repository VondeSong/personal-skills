{
  "format": "apple-ui-design-tokens",
  "version": "3.0",
  "note": "Custom web/mockup token format, not official Apple values or a DTCG schema. Native implementations use system roles first. All geometry here is CSS px except nativeControlGuidance.",
  "fontFamily": {
    "system": "-apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif"
  },
  "fontWeight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "webTypography": {
    "desktop": {
      "title": {
        "size": 22,
        "lineHeight": 28,
        "weight": 600
      },
      "sectionTitle": {
        "size": 16,
        "lineHeight": 22,
        "weight": 600
      },
      "body": {
        "size": 14,
        "lineHeight": 20,
        "weight": 400
      },
      "control": {
        "size": 13,
        "lineHeight": 18,
        "weight": 500
      },
      "meta": {
        "size": 12,
        "lineHeight": 16,
        "weight": 400
      }
    },
    "mobile": {
      "title": {
        "size": 28,
        "lineHeight": 34,
        "weight": 600
      },
      "sectionTitle": {
        "size": 20,
        "lineHeight": 26,
        "weight": 600
      },
      "body": {
        "size": 17,
        "lineHeight": 25,
        "weight": 400
      },
      "control": {
        "size": 17,
        "lineHeight": 24,
        "weight": 500
      },
      "meta": {
        "size": 13,
        "lineHeight": 18,
        "weight": 400
      }
    },
    "editorial": {
      "title": {
        "size": 48,
        "lineHeight": 54,
        "weight": 600
      },
      "sectionTitle": {
        "size": 28,
        "lineHeight": 34,
        "weight": 600
      },
      "body": {
        "size": 18,
        "lineHeight": 28,
        "weight": 400
      },
      "control": {
        "size": 16,
        "lineHeight": 24,
        "weight": 500
      },
      "meta": {
        "size": 14,
        "lineHeight": 20,
        "weight": 400
      }
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "radius": {
    "small": 6,
    "control": 8,
    "card": 12,
    "panel": 16,
    "sheet": 20,
    "pill": 999
  },
  "nativeControlGuidance": {
    "unit": "pt",
    "macOS": {
      "default": 28,
      "minimum": 20
    },
    "iOS": {
      "default": 44,
      "minimum": 28
    },
    "iPadOS": {
      "default": 44,
      "minimum": 28
    },
    "note": "Default and minimum refer to width and height; prefer standard controls and appropriate spacing. These are guidance, not forced layout constants."
  },
  "webControlGuidance": {
    "unit": "CSS px",
    "touchTarget": 44,
    "compactDesktopControl": 28,
    "note": "Product defaults, not native point conversion or a universal WCAG minimum. Keep effective targets accessible and non-overlapping."
  },
  "colorRoles": {
    "bgCanvas": "surface",
    "bgContent": "surface",
    "bgSecondary": "surface",
    "textPrimary": "text",
    "textSecondary": "text",
    "textTertiary": "text",
    "separator": "decorative",
    "controlBorder": "indicator",
    "focusRing": "indicator",
    "accent": "text",
    "onAccent": "text",
    "selectionBg": "surface",
    "selectionText": "text",
    "success": "text",
    "successBg": "surface",
    "warning": "text",
    "warningBg": "surface",
    "destructive": "text",
    "destructiveBg": "surface"
  },
  "light": {
    "bgCanvas": "#F5F5F7",
    "bgContent": "#FFFFFF",
    "bgSecondary": "#F2F2F4",
    "textPrimary": "#1D1D1F",
    "textSecondary": "#606066",
    "textTertiary": "#6B6B70",
    "separator": "#D2D2D7",
    "controlBorder": "#767680",
    "focusRing": "#005FCC",
    "accent": "#0066CC",
    "onAccent": "#FFFFFF",
    "selectionBg": "#E5F0FF",
    "selectionText": "#003F88",
    "success": "#18733B",
    "successBg": "#E8F5EC",
    "warning": "#855000",
    "warningBg": "#FFF2D6",
    "destructive": "#B42318",
    "destructiveBg": "#FFF0EE"
  },
  "dark": {
    "bgCanvas": "#121214",
    "bgContent": "#1C1C1E",
    "bgSecondary": "#2C2C2E",
    "textPrimary": "#F5F5F7",
    "textSecondary": "#BCBCC2",
    "textTertiary": "#A0A0A8",
    "separator": "#48484D",
    "controlBorder": "#91919A",
    "focusRing": "#83C1FF",
    "accent": "#69B4FF",
    "onAccent": "#061728",
    "selectionBg": "#163D64",
    "selectionText": "#D9EDFF",
    "success": "#80E4A0",
    "successBg": "#163A25",
    "warning": "#FFD078",
    "warningBg": "#493313",
    "destructive": "#FFB4AC",
    "destructiveBg": "#4D2222"
  },
  "highContrastOverrides": {
    "light": {
      "bgCanvas": "#FFFFFF",
      "bgContent": "#FFFFFF",
      "bgSecondary": "#F5F5F5",
      "textPrimary": "#000000",
      "textSecondary": "#303030",
      "textTertiary": "#404040",
      "controlBorder": "#404040",
      "focusRing": "#003D80",
      "accent": "#004A99",
      "selectionText": "#002F66",
      "success": "#10552C",
      "warning": "#623B00",
      "destructive": "#891B12"
    },
    "dark": {
      "bgCanvas": "#000000",
      "bgContent": "#000000",
      "bgSecondary": "#141414",
      "textPrimary": "#FFFFFF",
      "textSecondary": "#E5E5EA",
      "textTertiary": "#D1D1D6",
      "controlBorder": "#D1D1D6",
      "focusRing": "#AED7FF",
      "accent": "#9CCDFF",
      "onAccent": "#000000",
      "selectionText": "#FFFFFF",
      "success": "#A0F0B8",
      "warning": "#FFE0A1",
      "destructive": "#FFD0CB"
    }
  },
  "contrastContracts": [
    {
      "foreground": "textPrimary",
      "backgrounds": [
        "bgCanvas",
        "bgContent",
        "bgSecondary"
      ]
    },
    {
      "foreground": "textSecondary",
      "backgrounds": [
        "bgCanvas",
        "bgContent",
        "bgSecondary"
      ]
    },
    {
      "foreground": "textTertiary",
      "backgrounds": [
        "bgCanvas",
        "bgContent",
        "bgSecondary"
      ]
    },
    {
      "foreground": "accent",
      "backgrounds": [
        "bgCanvas",
        "bgContent",
        "bgSecondary"
      ]
    },
    {
      "foreground": "onAccent",
      "backgrounds": [
        "accent"
      ]
    },
    {
      "foreground": "selectionText",
      "backgrounds": [
        "selectionBg"
      ]
    },
    {
      "foreground": "success",
      "backgrounds": [
        "bgCanvas",
        "bgContent",
        "bgSecondary",
        "successBg"
      ]
    },
    {
      "foreground": "warning",
      "backgrounds": [
        "bgCanvas",
        "bgContent",
        "bgSecondary",
        "warningBg"
      ]
    },
    {
      "foreground": "destructive",
      "backgrounds": [
        "bgCanvas",
        "bgContent",
        "bgSecondary",
        "destructiveBg"
      ]
    },
    {
      "foreground": "controlBorder",
      "backgrounds": [
        "bgCanvas",
        "bgContent",
        "bgSecondary"
      ]
    },
    {
      "foreground": "focusRing",
      "backgrounds": [
        "bgCanvas",
        "bgContent",
        "bgSecondary",
        "selectionBg"
      ]
    }
  ],
  "webPreviewMaterial": {
    "regular": {
      "light": "rgba(250,250,252,0.88)",
      "dark": "rgba(30,30,32,0.88)",
      "backdropBlurCSSPx": 20,
      "opaqueFallbackRole": "bgContent"
    },
    "clear": {
      "light": "rgba(255,255,255,0.50)",
      "dark": "rgba(28,28,30,0.50)",
      "backdropBlurCSSPx": 12,
      "opaqueFallbackRole": "bgContent"
    },
    "note": "Preview approximations only. No contrast guarantees over arbitrary content. Use opaqueFallbackRole without blur for unsupported/reduced-transparency configurations, and when contrast cannot be maintained."
  },
  "shadow": {
    "floating": "0 8px 30px rgba(0,0,0,0.12)",
    "popover": "0 12px 40px rgba(0,0,0,0.16)"
  }
}
