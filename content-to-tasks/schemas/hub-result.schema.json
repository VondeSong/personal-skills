{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "content-to-tasks Hub result v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "didaPolicyVersion", "mode", "executor", "operationId", "itemId", "contentRevision", "destination", "source", "status", "tasks", "attachments", "verification", "issues", "reason"],
  "properties": {
    "contractVersion": {"const": "content-to-tasks-hub-v3"},
    "didaPolicyVersion": {"const": "inbox-notes-v2"},
    "mode": {"enum": ["plan_only", "execute"]},
    "executor": {"enum": ["host", "agent"]},
    "operationId": {"$ref": "#/$defs/id"},
    "itemId": {"$ref": "#/$defs/id"},
    "contentRevision": {"$ref": "#/$defs/id"},
    "destination": {
      "type": "object", "additionalProperties": false,
      "required": ["accountId", "libraryId", "allowedProjectIds"],
      "properties": {
        "accountId": {"$ref": "#/$defs/id"},
        "libraryId": {"$ref": "#/$defs/id"},
        "allowedProjectIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["title", "urls"],
      "properties": {
        "title": {"type": "string"},
        "urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https?://"}},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "status": {"enum": ["planned", "needs_input", "needs_connection", "executed", "partial", "failed", "unknown"]},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "attachments": {"type": "array", "items": {"$ref": "#/$defs/attachment"}},
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["readBack"],
      "properties": {"readBack": {"type": "boolean"}, "verifiedAt": {"type": "string", "format": "date-time"}}
    },
    "issues": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "reason": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "plan_only"}}}, "then": {"properties": {
      "executor": {"const": "host"},
      "status": {"enum": ["planned", "needs_input", "needs_connection", "failed"]},
      "verification": {"properties": {"readBack": {"const": false}}, "not": {"required": ["verifiedAt"]}},
      "tasks": {"items": {"properties": {"verified": {"const": false}, "writeConfirmed": {"const": false}}}},
      "attachments": {"items": {"properties": {"state": {"enum": ["planned", "skipped"]}}, "not": {"required": ["remoteId"]}}}
    }}},
    {"if": {"properties": {"status": {"const": "executed"}}}, "then": {"properties": {
      "mode": {"const": "execute"},
      "verification": {"required": ["verifiedAt"], "properties": {"readBack": {"const": true}}},
      "tasks": {"minItems": 1, "items": {"required": ["remoteId"], "properties": {"verified": {"const": true}}}},
      "attachments": {"items": {"if": {"properties": {"required": {"const": true}}}, "then": {"properties": {"state": {"const": "readable"}}}}}
    }}},
    {"if": {"properties": {"status": {"enum": ["needs_input", "needs_connection", "partial", "failed", "unknown"]}}}, "then": {"properties": {"issues": {"minItems": 1}}}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "task": {
      "type": "object", "additionalProperties": false, "required": ["projectId", "kind"],
      "properties": {
        "projectId": {"$ref": "#/$defs/id"}, "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/id"}, "kind": {"enum": ["TEXT", "NOTE", "CHECKLIST"]},
        "content": {"type": "string"}, "desc": {"type": "string"},
        "columnId": {"$ref": "#/$defs/id"}, "parentId": {"type": "string"},
        "tags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "priority": {"enum": [0, 1, 3, 5]}, "status": {"type": "integer"},
        "startDate": {"type": "string"}, "dueDate": {"type": "string"},
        "timeZone": {"$ref": "#/$defs/id"}, "isAllDay": {"type": "boolean"},
        "reminders": {"type": "array", "items": {"type": "string"}},
        "repeatFlag": {"type": "string"}, "repeatFrom": {"type": "integer"},
        "assigneeUsername": {"type": "string"}, "sortOrder": {"type": "number"},
        "etag": {"type": "string"}, "completedTime": {"type": "string"},
        "items": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["title"], "properties": {
            "id": {"$ref": "#/$defs/id"}, "title": {"type": "string"},
            "status": {"enum": [0, 1]}, "sortOrder": {"type": "number"},
            "startDate": {"type": "string"}, "isAllDay": {"type": "boolean"}, "timeZone": {"type": "string"}, "completedTime": {"type": "string"}
          }}}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["localId", "taskClass", "operation", "task", "sourceEvidence", "verified"],
      "properties": {
        "localId": {"$ref": "#/$defs/id"}, "taskClass": {"enum": ["reference", "action"]},
        "operation": {"enum": ["create", "update", "reuse"]},
        "task": {"$ref": "#/$defs/task"}, "remoteId": {"$ref": "#/$defs/id"},
        "parentLocalId": {"$ref": "#/$defs/id"},
        "explicit_fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/id"}},
        "sourceEvidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "verified": {"type": "boolean"}, "writeConfirmed": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"taskClass": {"const": "reference"}}}, "then": {"properties": {"task": {"properties": {"kind": {"const": "NOTE"}}}}}, "else": {"properties": {"task": {"properties": {"kind": {"enum": ["TEXT", "CHECKLIST"]}}}}}},
        {"if": {"properties": {"operation": {"const": "create"}}}, "then": {"properties": {"task": {"required": ["title"]}}}, "else": {"required": ["remoteId"], "properties": {"task": {"required": ["id"]}}}},
        {"if": {"required": ["writeConfirmed"], "properties": {"writeConfirmed": {"const": true}}}, "then": {"required": ["remoteId"]}}
      ]
    },
    "attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "localTaskId", "name", "required", "state"],
      "properties": {
        "sourceId": {"$ref": "#/$defs/id"}, "localTaskId": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/hash"},
        "required": {"type": "boolean"},
        "state": {"enum": ["planned", "uploaded", "linked", "readable", "failed", "unknown", "skipped"]},
        "remoteId": {"$ref": "#/$defs/id"}
      },
      "allOf": [{"if": {"properties": {"state": {"enum": ["uploaded", "linked", "readable"]}}}, "then": {"required": ["remoteId"]}}]
    }
  }
}
